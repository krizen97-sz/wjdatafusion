# 官方 Community 9.4.0 多架构清单；固定 digest，避免标签漂移。
# 现场生产正式使用前需完成 AGPL/商业许可评审；如采购 Enterprise，请替换为审批镜像。
ONLYOFFICE_IMAGE=onlyoffice/documentserver:9.4.0@sha256:e3da62a847b9a5d51a11f73cfea1d9c13c3be3809614490d4edddcf01dcf919b
# 完全离线时，先 docker load，再把 ONLYOFFICE_IMAGE 改为已导入标签并设为 true。
ONLYOFFICE_SKIP_PULL=false

# 使用 openssl rand -hex 32 生成；必须与后端 DOCUMENT_ONLYOFFICE_JWT_SECRET 完全一致。
ONLYOFFICE_JWT_SECRET=replace-with-at-least-32-random-characters

# 独立网关发布 8082；DocumentServer 本身不发布宿主机端口。
ONLYOFFICE_PUBLIC_BIND_IP=0.0.0.0
ONLYOFFICE_PUBLIC_PORT=8082
ONLYOFFICE_SHM_SIZE=1gb

# 仅用于验收脚本验证容器能够回调当前 RuoYi 后端。
RUOYI_BACKEND_URL=http://onlyoffice-gateway:8083

# 浏览器访问地址复用业务前端的公网映射和 /onlyoffice 虚拟路径。
ONLYOFFICE_PUBLIC_URL=http://139.224.24.77:5555/onlyoffice
