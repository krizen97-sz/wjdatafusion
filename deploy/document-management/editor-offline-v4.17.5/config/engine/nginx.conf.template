map $http_upgrade $document_upgrade {
    default upgrade;
    '' close;
}
map $http_x_forwarded_proto $document_proto {
    default $http_x_forwarded_proto;
    '' $scheme;
}
map $http_x_forwarded_host $document_host {
    default $http_x_forwarded_host;
    '' $http_host;
}
upstream onlyoffice_documentserver {
    server onlyoffice-documentserver:80;
    keepalive 32;
}
upstream rynew_backend {
    server __BACKEND_HOST__:__BACKEND_PORT__;
    keepalive 16;
}
server {
    listen 8082;
    client_max_body_size 100m;
    location / {
        proxy_pass http://onlyoffice_documentserver;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $document_proto;
        proxy_set_header X-Forwarded-Host $document_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $document_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
# Only on the private Docker network; no host port is published for this server.
server {
    listen 8083;
    client_max_body_size 100m;
    location /document/workspace/editor/ {
        proxy_pass http://rynew_backend;
        proxy_http_version 1.1;
        proxy_set_header Host __BACKEND_HOST__:__BACKEND_PORT__;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
    }
    location / { return 404; }
}
