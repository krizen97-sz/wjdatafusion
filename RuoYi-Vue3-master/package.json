  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ui:guard": "node scripts/ui-guard.mjs",
    "test:ui-guard": "node --test scripts/__tests__/ui-guard.test.mjs",
    "test:icons": "node --test src/components/IconSelect/__tests__/menuIconLibrary.test.js",
    "test:ipam": "node --test src/views/ipam/__tests__/*.test.js",
    "test:knowledge": "node --test src/views/knowledge/__tests__/*.test.js",
    "test:auto-inspection": "node --test src/views/support/autoInspection/__tests__/*.test.js",
    "verify:frontend": "npm run ui:guard && npm run test:ui-guard && npm run test:icons && npm run test:ipam && npm run test:knowledge && npm run test:auto-inspection && npm run build:prod",
    "build:prod": "vite build",
    "build:stage": "vite build --mode staging",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/krizen97-sz/wjdatafusion.git"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@revolist/vue3-datagrid": "4.25.2",
    "@vueup/vue-quill": "1.2.0",
    "@vueuse/core": "14.1.0",
    "axios": "1.13.2",
    "clipboard": "2.0.11",
    "echarts": "5.6.0",
    "element-china-area-data": "^6.1.0",
    "element-plus": "2.13.1",
    "file-saver": "2.0.5",
    "fuse.js": "7.1.0",
    "js-beautify": "1.15.4",
    "js-cookie": "3.0.5",
    "jsencrypt": "3.3.2",
    "pinia": "3.0.4",
    "pinyin-pro": "^3.28.0",
    "splitpanes": "4.0.4",
    "three": "0.185.1",
    "vue": "3.5.26",
    "vue-cropper": "1.1.1",
    "vue-router": "4.6.4",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "sass-embedded": "1.97.2",
    "unplugin-auto-import": "0.18.6",
    "unplugin-vue-setup-extend-plus": "1.0.1",
    "vite": "6.4.1",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-svg-icons": "2.0.1"
  },
  "overrides": {
    "quill": "2.0.2"
  },
