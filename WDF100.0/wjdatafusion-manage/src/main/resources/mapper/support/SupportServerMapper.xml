<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hm.manage.mapper.SupportServerMapper">

    <resultMap id="SupportServerResult" type="SupportServer">
        <result property="serverId" column="server_id"/>
        <result property="siteId" column="site_id"/>
        <result property="serverName" column="server_name"/>
        <result property="serverAddress" column="server_address"/>
        <result property="sshPort" column="ssh_port"/>
        <result property="osType" column="os_type"/>
        <result property="equipmentRoom" column="equipment_room"/>
        <result property="cabinetNo" column="cabinet_no"/>
        <result property="rackUStart" column="rack_u_start"/>
        <result property="rackUEnd" column="rack_u_end"/>
        <result property="osUsername" column="os_username"/>
        <result property="osPasswordCipher" column="os_password_cipher"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectSupportServerVo">
        select server_id, site_id, server_name, server_address, ssh_port, os_type,
               equipment_room, cabinet_no, rack_u_start, rack_u_end,
               os_username, os_password_cipher,
               status, create_by, create_time, update_by, update_time, remark
        from sup_server
    </sql>

    <select id="selectSupportServerByServerId" parameterType="Long" resultMap="SupportServerResult">
        <include refid="selectSupportServerVo"/>
        where server_id = #{serverId}
    </select>

    <select id="selectSupportServerBySiteAndAddress" resultMap="SupportServerResult">
        <include refid="selectSupportServerVo"/>
        where site_id = #{siteId} and server_address = #{serverAddress}
        limit 1
    </select>

    <select id="selectSupportServerList" parameterType="SupportServer" resultMap="SupportServerResult">
        <include refid="selectSupportServerVo"/>
        <where>
            <if test="siteId != null">and site_id = #{siteId}</if>
            <if test="serverName != null and serverName != ''">and server_name like concat('%', #{serverName}, '%')</if>
            <if test="serverAddress != null and serverAddress != ''">and server_address like concat('%', #{serverAddress}, '%')</if>
            <if test="sshPort != null">and ssh_port = #{sshPort}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by server_id desc
    </select>

    <select id="selectServersByPlatformId" parameterType="Long" resultMap="SupportServerResult">
        <include refid="selectSupportServerVo"/>
        where server_id in (select server_id from sup_platform_server_rel where platform_id = #{platformId})
        order by server_id desc
    </select>

    <insert id="insertSupportServer" parameterType="SupportServer" useGeneratedKeys="true" keyProperty="serverId">
        insert into sup_server
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="siteId != null">site_id,</if>
            <if test="serverName != null and serverName != ''">server_name,</if>
            <if test="serverAddress != null and serverAddress != ''">server_address,</if>
            <if test="sshPort != null">ssh_port,</if>
            <if test="osType != null">os_type,</if>
            <if test="equipmentRoom != null">equipment_room,</if>
            <if test="cabinetNo != null">cabinet_no,</if>
            <if test="rackUStart != null">rack_u_start,</if>
            <if test="rackUEnd != null">rack_u_end,</if>
            <if test="osUsername != null">os_username,</if>
            <if test="osPasswordCipher != null and osPasswordCipher != ''">os_password_cipher,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="siteId != null">#{siteId},</if>
            <if test="serverName != null and serverName != ''">#{serverName},</if>
            <if test="serverAddress != null and serverAddress != ''">#{serverAddress},</if>
            <if test="sshPort != null">#{sshPort},</if>
            <if test="osType != null">#{osType},</if>
            <if test="equipmentRoom != null">#{equipmentRoom},</if>
            <if test="cabinetNo != null">#{cabinetNo},</if>
            <if test="rackUStart != null">#{rackUStart},</if>
            <if test="rackUEnd != null">#{rackUEnd},</if>
            <if test="osUsername != null">#{osUsername},</if>
            <if test="osPasswordCipher != null and osPasswordCipher != ''">#{osPasswordCipher},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateSupportServer" parameterType="SupportServer">
        update sup_server
        <trim prefix="SET" suffixOverrides=",">
            <if test="siteId != null">site_id = #{siteId},</if>
            <if test="serverName != null and serverName != ''">server_name = #{serverName},</if>
            <if test="serverAddress != null and serverAddress != ''">server_address = #{serverAddress},</if>
            <if test="sshPort != null">ssh_port = #{sshPort},</if>
            <if test="osType != null">os_type = #{osType},</if>
            <if test="equipmentRoom != null">equipment_room = #{equipmentRoom},</if>
            <if test="equipmentRoom == null">equipment_room = null,</if>
            <if test="cabinetNo != null">cabinet_no = #{cabinetNo},</if>
            <if test="cabinetNo == null">cabinet_no = null,</if>
            <if test="rackUStart != null">rack_u_start = #{rackUStart},</if>
            <if test="rackUStart == null">rack_u_start = null,</if>
            <if test="rackUEnd != null">rack_u_end = #{rackUEnd},</if>
            <if test="rackUEnd == null">rack_u_end = null,</if>
            <if test="osUsername != null">os_username = #{osUsername},</if>
            <if test="osPasswordCipher != null and osPasswordCipher != ''">os_password_cipher = #{osPasswordCipher},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where server_id = #{serverId}
    </update>

    <delete id="deleteSupportServerByServerId" parameterType="Long">
        delete from sup_server where server_id = #{serverId}
    </delete>

    <delete id="deleteSupportServerByServerIds" parameterType="String">
        delete from sup_server where server_id in
        <foreach item="serverId" collection="array" open="(" separator="," close=")">
            #{serverId}
        </foreach>
    </delete>
</mapper>
