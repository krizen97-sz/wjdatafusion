    <select id="selectItemConfigList" resultMap="SupportTimInspectionItemConfigResult">
        select c.config_id, c.item_code, c.item_name, c.item_type, c.enabled_flag, c.sort_order,
               c.threshold_value, c.threshold_unit, c.compare_rule, c.time_window_minutes,
               c.timeout_seconds, c.status, c.create_by, c.create_time, c.update_by, c.update_time,
               c.remark,
               (select count(1) from sup_tim_inspection_target t where t.item_code = c.item_code and t.status = '0') as target_count
        from sup_tim_inspection_item_config c
        order by c.sort_order asc, c.config_id asc
    </select>

