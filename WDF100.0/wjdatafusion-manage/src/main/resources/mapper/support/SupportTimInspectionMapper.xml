    <sql id="selectInspectionVo">
        select inspection_id, inspection_time, inspection_type, source_type, result_status, executor_name,
               plan_id, plan_name, report_style,
               enabled_item_count, skipped_item_count, summary, abnormal_summary,
               create_by, create_time, update_by, update_time, remark
        from sup_tim_inspection
    </sql>

    <select id="selectInspectionList" parameterType="SupportTimInspection" resultMap="SupportTimInspectionResult">
        <include refid="selectInspectionVo"/>
        <where>
            <if test="inspectionType != null and inspectionType != ''">and inspection_type = #{inspectionType}</if>
            <if test="sourceType != null and sourceType != ''">and source_type = #{sourceType}</if>
            <if test="resultStatus != null and resultStatus != ''">and result_status = #{resultStatus}</if>
            <if test="planId != null">and plan_id = #{planId}</if>
            <if test="planName != null and planName != ''">and plan_name like concat('%', #{planName}, '%')</if>
            <if test="executorName != null and executorName != ''">and executor_name like concat('%', #{executorName}, '%')</if>
        </where>
        order by inspection_time desc, inspection_id desc
    </select>

    <select id="selectInspectionById" parameterType="Long" resultMap="SupportTimInspectionResult">
        <include refid="selectInspectionVo"/>
        where inspection_id = #{inspectionId}
    </select>

