    <sql id="selectTargetVo">
        select t.target_id, t.item_code, t.target_name, t.target_type, t.server_id,
               s.server_name, s.server_address,
               t.host, t.port, t.path, t.url, t.http_method, t.topic, t.consumer_group,
               t.username, t.password_cipher, t.app_key, t.secret_cipher, t.result_path,
               t.extra_params, t.status, t.create_by, t.create_time, t.update_by,
               t.update_time, t.remark
        from sup_tim_inspection_target t
        left join sup_server s on s.server_id = t.server_id
