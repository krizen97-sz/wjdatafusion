    <select id="selectTargetList" parameterType="SupportTimInspectionTarget" resultMap="SupportTimInspectionTargetResultMap">
        <include refid="selectTargetVo"/>
        <where>
            <if test="itemCode != null and itemCode != ''">and t.item_code = #{itemCode}</if>
            <if test="targetName != null and targetName != ''">and t.target_name like concat('%', #{targetName}, '%')</if>
            <if test="targetType != null and targetType != ''">and t.target_type = #{targetType}</if>
            <if test="status != null and status != ''">and t.status = #{status}</if>
        </where>
        order by t.target_id desc
