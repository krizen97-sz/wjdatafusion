<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hm.manage.mapper.SupportPlatformMapper">

    <resultMap id="SupportPlatformResult" type="SupportPlatform">
        <result property="platformId" column="platform_id"/>
        <result property="siteId" column="site_id"/>
        <result property="platformName" column="platform_name"/>
        <result property="platformLevel" column="platform_level"/>
        <result property="networkEnv" column="network_env"/>
        <result property="parentPlatformId" column="parent_platform_id"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectSupportPlatformVo">
        select platform_id, site_id, platform_name, platform_level, network_env, parent_platform_id,
               status, create_by, create_time, update_by, update_time, remark
        from sup_platform
    </sql>

    <select id="selectSupportPlatformByPlatformId" parameterType="Long" resultMap="SupportPlatformResult">
        <include refid="selectSupportPlatformVo"/>
        where platform_id = #{platformId}
    </select>

    <select id="selectSupportPlatformList" parameterType="SupportPlatform" resultMap="SupportPlatformResult">
        <include refid="selectSupportPlatformVo"/>
        <where>
            <if test="siteId != null">and site_id = #{siteId}</if>
            <if test="platformName != null and platformName != ''">and platform_name like concat('%', #{platformName}, '%')</if>
            <if test="platformLevel != null and platformLevel != ''">and platform_level = #{platformLevel}</if>
            <if test="networkEnv != null and networkEnv != ''">and network_env = #{networkEnv}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by platform_id desc
    </select>

    <select id="selectPlatformsBySiteId" parameterType="Long" resultMap="SupportPlatformResult">
        <include refid="selectSupportPlatformVo"/>
        where site_id = #{siteId}
        order by parent_platform_id asc, platform_id asc
    </select>

    <select id="selectPlatformsByOrgId" parameterType="Long" resultMap="SupportPlatformResult">
        <include refid="selectSupportPlatformVo"/>
        where platform_id in (
            select distinct pcr.platform_id
            from sup_platform_contact_rel pcr
                     inner join sup_contact c on c.contact_id = pcr.contact_id
            where c.org_id = #{orgId}
        )
        order by parent_platform_id asc, platform_id asc
    </select>

    <select id="selectPlatformsByContactId" parameterType="Long" resultMap="SupportPlatformResult">
        <include refid="selectSupportPlatformVo"/>
        where platform_id in (
            select platform_id from sup_platform_contact_rel where contact_id = #{contactId}
        )
        order by parent_platform_id asc, platform_id asc
    </select>

    <insert id="insertSupportPlatform" parameterType="SupportPlatform" useGeneratedKeys="true" keyProperty="platformId">
        insert into sup_platform
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="siteId != null">site_id,</if>
            <if test="platformName != null and platformName != ''">platform_name,</if>
            <if test="platformLevel != null and platformLevel != ''">platform_level,</if>
            <if test="networkEnv != null and networkEnv != ''">network_env,</if>
            <if test="parentPlatformId != null">parent_platform_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="siteId != null">#{siteId},</if>
            <if test="platformName != null and platformName != ''">#{platformName},</if>
            <if test="platformLevel != null and platformLevel != ''">#{platformLevel},</if>
            <if test="networkEnv != null and networkEnv != ''">#{networkEnv},</if>
            <if test="parentPlatformId != null">#{parentPlatformId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateSupportPlatform" parameterType="SupportPlatform">
        update sup_platform
        <trim prefix="SET" suffixOverrides=",">
            <if test="siteId != null">site_id = #{siteId},</if>
            <if test="platformName != null and platformName != ''">platform_name = #{platformName},</if>
            <if test="platformLevel != null and platformLevel != ''">platform_level = #{platformLevel},</if>
            <if test="networkEnv != null and networkEnv != ''">network_env = #{networkEnv},</if>
            <if test="networkEnv == null or networkEnv == ''">network_env = null,</if>
            <if test="parentPlatformId != null">parent_platform_id = #{parentPlatformId},</if>
            <if test="parentPlatformId == null">parent_platform_id = null,</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where platform_id = #{platformId}
    </update>

    <delete id="deleteSupportPlatformByPlatformId" parameterType="Long">
        delete from sup_platform where platform_id = #{platformId}
    </delete>

    <delete id="deleteSupportPlatformByPlatformIds" parameterType="String">
        delete from sup_platform where platform_id in
        <foreach item="platformId" collection="array" open="(" separator="," close=")">
            #{platformId}
        </foreach>
    </delete>

    <select id="countChildPlatforms" parameterType="Long" resultType="int">
        select count(1) from sup_platform where parent_platform_id = #{platformId}
    </select>
</mapper>
