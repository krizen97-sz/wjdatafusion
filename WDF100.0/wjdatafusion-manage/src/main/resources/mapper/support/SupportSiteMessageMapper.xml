<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hm.manage.mapper.SupportSiteMessageMapper">

    <resultMap id="SupportSiteMessageResult" type="SupportSiteMessage">
        <result property="messageId" column="message_id"/>
        <result property="siteId" column="site_id"/>
        <result property="messageContent" column="message_content"/>
        <result property="publisherId" column="publisher_id"/>
        <result property="publisherName" column="publisher_name"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectSupportSiteMessageVo">
        select message_id, site_id, message_content, publisher_id, publisher_name,
               status, create_by, create_time, update_by, update_time, remark
        from sup_site_message
    </sql>

    <select id="selectSupportSiteMessageList" parameterType="SupportSiteMessage" resultMap="SupportSiteMessageResult">
        <include refid="selectSupportSiteMessageVo"/>
        <where>
            and site_id = #{siteId}
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="status == null or status == ''">and status = '0'</if>
            <if test="messageContent != null and messageContent != ''">and message_content like concat('%', #{messageContent}, '%')</if>
            <if test="publisherName != null and publisherName != ''">and publisher_name like concat('%', #{publisherName}, '%')</if>
        </where>
        order by message_id desc
    </select>

    <select id="selectLatestSupportSiteMessages" resultMap="SupportSiteMessageResult">
        <include refid="selectSupportSiteMessageVo"/>
        where site_id = #{siteId}
          and status = '0'
        <if test="afterMessageId != null">
          and message_id &gt; #{afterMessageId}
        </if>
        order by message_id desc
        limit #{limit}
    </select>

    <select id="selectMessagesBySiteId" parameterType="Long" resultMap="SupportSiteMessageResult">
        <include refid="selectSupportSiteMessageVo"/>
        where site_id = #{siteId}
          and status = '0'
        order by message_id asc
    </select>

    <insert id="insertSupportSiteMessage" parameterType="SupportSiteMessage" useGeneratedKeys="true" keyProperty="messageId">
        insert into sup_site_message
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="siteId != null">site_id,</if>
            <if test="messageContent != null and messageContent != ''">message_content,</if>
            <if test="publisherId != null">publisher_id,</if>
            <if test="publisherName != null">publisher_name,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="siteId != null">#{siteId},</if>
            <if test="messageContent != null and messageContent != ''">#{messageContent},</if>
            <if test="publisherId != null">#{publisherId},</if>
            <if test="publisherName != null">#{publisherName},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <delete id="deleteSupportSiteMessagesBySiteIds">
        delete from sup_site_message where site_id in
        <foreach collection="siteIds" item="siteId" open="(" separator="," close=")">
            #{siteId}
        </foreach>
    </delete>
</mapper>
