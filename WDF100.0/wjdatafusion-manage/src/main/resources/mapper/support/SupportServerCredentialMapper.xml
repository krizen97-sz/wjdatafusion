<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hm.manage.mapper.SupportServerCredentialMapper">

    <resultMap id="SupportServerCredentialResult" type="SupportServerCredential">
        <result property="credentialId" column="credential_id"/>
        <result property="serverId" column="server_id"/>
        <result property="credentialName" column="credential_name"/>
        <result property="username" column="username"/>
        <result property="passwordCipher" column="password_cipher"/>
        <result property="purpose" column="purpose"/>
        <result property="isDefault" column="is_default"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectCredentialVo">
        select credential_id, server_id, credential_name, username, password_cipher, purpose, is_default,
               status, create_by, create_time, update_by, update_time, remark
        from sup_server_credential
    </sql>

    <select id="selectCredentialById" parameterType="Long" resultMap="SupportServerCredentialResult">
        <include refid="selectCredentialVo"/>
        where credential_id = #{credentialId}
    </select>

    <select id="selectCredentialsByServerId" parameterType="Long" resultMap="SupportServerCredentialResult">
        <include refid="selectCredentialVo"/>
        where server_id = #{serverId}
        order by is_default desc, credential_id desc
    </select>

    <select id="selectCredentialByServerIdAndUsername" resultMap="SupportServerCredentialResult">
        <include refid="selectCredentialVo"/>
        where server_id = #{serverId}
          and username = #{username}
        limit 1
    </select>

    <select id="selectCredentialByServerIdAndName" resultMap="SupportServerCredentialResult">
        <include refid="selectCredentialVo"/>
        where server_id = #{serverId}
          and credential_name = #{credentialName}
        limit 1
    </select>

    <insert id="insertCredential" parameterType="SupportServerCredential" useGeneratedKeys="true" keyProperty="credentialId">
        insert into sup_server_credential
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="serverId != null">server_id,</if>
            <if test="credentialName != null and credentialName != ''">credential_name,</if>
            <if test="username != null and username != ''">username,</if>
            <if test="passwordCipher != null and passwordCipher != ''">password_cipher,</if>
            <if test="purpose != null">purpose,</if>
            <if test="isDefault != null and isDefault != ''">is_default,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="serverId != null">#{serverId},</if>
            <if test="credentialName != null and credentialName != ''">#{credentialName},</if>
            <if test="username != null and username != ''">#{username},</if>
            <if test="passwordCipher != null and passwordCipher != ''">#{passwordCipher},</if>
            <if test="purpose != null">#{purpose},</if>
            <if test="isDefault != null and isDefault != ''">#{isDefault},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateCredential" parameterType="SupportServerCredential">
        update sup_server_credential
        <trim prefix="SET" suffixOverrides=",">
            <if test="credentialName != null and credentialName != ''">credential_name = #{credentialName},</if>
            <if test="username != null and username != ''">username = #{username},</if>
            <if test="passwordCipher != null and passwordCipher != ''">password_cipher = #{passwordCipher},</if>
            <if test="purpose != null">purpose = #{purpose},</if>
            <if test="isDefault != null and isDefault != ''">is_default = #{isDefault},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where credential_id = #{credentialId}
    </update>

    <update id="clearDefaultByServerId">
        update sup_server_credential
        set is_default = '0'
        where server_id = #{serverId}
        <if test="excludeCredentialId != null">and credential_id != #{excludeCredentialId}</if>
    </update>

    <delete id="deleteCredentialById" parameterType="Long">
        delete from sup_server_credential where credential_id = #{credentialId}
    </delete>

    <delete id="deleteCredentialsByServerId" parameterType="Long">
        delete from sup_server_credential where server_id = #{serverId}
    </delete>
</mapper>
